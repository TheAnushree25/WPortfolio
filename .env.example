# The Calendly event link for /contact, e.g. https://calendly.com/theatlasstudio/meeting.
# Set, it takes priority: the site's form hands the visitor's details to Calendly,
# which owns the slots, the bookings and every email (README.md → "Bookings").
NEXT_PUBLIC_CALENDLY_URL=

# Without Calendly: the Cal.com booking link for /contact, as "username/event-slug".
# Leave empty to use the studio's own booking page (below).
NEXT_PUBLIC_CAL_LINK=

# --- Without Calendly: bookings through the studio's Google account ----------
# Leave these empty while Calendly is set: two systems taking bookings can both
# accept the same time. (README.md → "Bookings" → "Without Calendly")
# An OAuth client of type "Desktop app" from Google Cloud, with the Calendar
# and Gmail APIs enabled. Server-side only: never prefix these with NEXT_PUBLIC.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Written by `node scripts/google/authorize.mjs` after you sign in as the studio.
GOOGLE_REFRESH_TOKEN=

# Optional. Which calendar takes the meetings ("primary" is the account's own).
BOOKING_CALENDAR_ID=primary
# Optional. Where the "new booking" note goes (defaults to contact.theatlasstudio@gmail.com).
BOOKING_NOTIFY_EMAIL=
# Optional. Set to false to keep visitors off the invitation (Google then emails no one).
BOOKING_INVITE_GUEST=true
