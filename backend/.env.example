# The Atlas Studios backend. Copy to backend/.env for local work, or set these as
# environment variables where it's deployed (Vercel → the backend project →
# Settings → Environment Variables). README.md explains each step.

# ── Required ────────────────────────────────────────────────────────────────

# A fine-grained GitHub token for the site's repository only, with
#   Contents: Read and write · Metadata: Read · Deployments: Read · Commit statuses: Read
# (github.com → Settings → Developer settings → Fine-grained tokens).
GITHUB_TOKEN=
# The site's repository, as owner/name.
GITHUB_REPO=TheAnushree25/WPortfolio

# Postgres. On Vercel: Storage → Create → Neon (free) and connect it to this
# project; it sets DATABASE_URL for you. Leave empty on your own computer: the
# backend then keeps a Postgres of its own (PGlite) in ADMIN_DATA_DIR.
DATABASE_URL=

# 32+ random characters. Seals the stored Calendly token and two-step sign-in
# keys. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=

# Lets the first (owner) account be created at /admin/setup?token=<this>. Remove
# it once you're set up if you like; setup only ever works while no account exists.
ADMIN_SETUP_TOKEN=

# ── Where things are ────────────────────────────────────────────────────────

# The admin's public address, for links in emails.
ADMIN_PUBLIC_URL=https://theatlasstudios.vercel.app/admin
# The live site. Pictures it already serves are shown from there in the media library.
SITE_URL=https://theatlasstudios.vercel.app
# Shared with the site's /admin route (its ADMIN_PROXY_SECRET), which forwards
# requests here: it vouches for their forwarded host and the visitor's address.
ADMIN_PROXY_SECRET=
# Other sites allowed to send enquiries and visits, comma-separated.
SITE_ORIGINS=

# ── Publishing ──────────────────────────────────────────────────────────────

# The branch the live site is built from (empty: the repository's default, main).
GITHUB_BRANCH=
# Where admin edits wait to be published (built as a preview by Vercel). Set it to
# the live branch to make every save go live at once.
GITHUB_DRAFT_BRANCH=admin-drafts

# ── Email (optional: new-enquiry alerts, password resets, invitations) ─────

# Any SMTP server. Gmail: turn on 2-Step Verification, create an app password,
# and use  smtps://you%40gmail.com:the-app-password@smtp.gmail.com:465
# (write @ in the username as %40 and spaces in the password as %20).
SMTP_URL=
# Or Resend (resend.com) instead of SMTP.
RESEND_API_KEY=
# The sender, e.g.  Atlas Studios <contact.theatlasstudio@gmail.com>
MAIL_FROM=
# true: write emails to the console instead of sending them (local work).
MAIL_LOG=

# ── Schedule (optional) ─────────────────────────────────────────────────────

# Vercel Cron sends it to /admin/api/cron/daily (Calendly sync and tidying).
CRON_SECRET=

# ── Rarely changed ──────────────────────────────────────────────────────────

# PORT=4320
# ADMIN_HOST=127.0.0.1
# ADMIN_BASE_PATH=/admin
# ADMIN_DATA_DIR=.data/db
# ADMIN_SESSION_HOURS=12
# Behind a proxy of your own that sets X-Forwarded-For (Vercel is trusted already):
# ADMIN_TRUST_PROXY=true
