{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "static",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": ".ui/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/admin/api/cron/daily", "schedule": "30 2 * * *" }]
}
