# Copy to Admin/.env, or set these in the environment. Every one is optional.

# Where the admin listens. Keep 127.0.0.1 unless you mean to reach it from other
# devices: 0.0.0.0 opens it to your network (a phone on the same Wi-Fi, say).
ADMIN_PORT=4310
ADMIN_HOST=127.0.0.1

# The Atlas Studios site the admin manages. Defaults to the folder above Admin/.
SITE_ROOT=..

# Where the admin keeps its own data (accounts, enquiries, backups). Defaults to Admin/data.
ADMIN_DATA_DIR=data

# Sites allowed to send enquiries and page views to the admin's public endpoints,
# comma-separated, e.g. https://theatlasstudio.com,http://localhost:3100
SITE_ORIGINS=http://localhost:3100

# How long a sign-in lasts, in hours.
ADMIN_SESSION_HOURS=12

# Set ADMIN_SECURE_COOKIES=true when the admin is served over HTTPS (behind a proxy
# or tunnel), so the session cookie is marked Secure, and ADMIN_TRUST_PROXY=true to
# read the visitor's address from the proxy's headers.
ADMIN_SECURE_COOKIES=false
ADMIN_TRUST_PROXY=false

# Lets the first-run setup be finished from another device, at /setup?token=<value>.
# Without it, setup only works on the computer the admin runs on.
ADMIN_SETUP_TOKEN=

# The port the site's local preview runs on (Publish → Preview).
SITE_PREVIEW_PORT=3100
